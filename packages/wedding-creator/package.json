{
  "name": "@bodasdehoy/wedding-creator",
  "version": "1.0.0",
  "private": true,
  "description": "Creador de webs para bodas y eventos. Paquete compartido para Copilot, App Bodas, CRM, ERP.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "echo \"no lint configured\" && exit 0"
  },
  "peerDependencies": {
    "@emotion/react": ">=11.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "antd": "^5.29.0",
    "dayjs": "^1.11.0",
    "lucide-react": "^0.460.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "wedding",
    "creador",
    "bodasdehoy",
    "monorepo"
  ],
  "author": "BodasdeHoy",
  "license": "MIT"
}
