{
  "name": "@bodasdehoy/shared",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./communication": {
      "types": "./dist/communication/index.d.ts",
      "default": "./dist/communication/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./upload": {
      "types": "./dist/upload/index.d.ts",
      "default": "./dist/upload/index.js"
    },
    "./plans": {
      "types": "./dist/plans/index.d.ts",
      "default": "./dist/plans/index.js"
    },
    "./branding": {
      "types": "./dist/branding/index.d.ts",
      "default": "./dist/branding/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "echo \"no lint configured\" && exit 0"
  },
  "dependencies": {
    "jose": "^5.10.0",
    "js-cookie": "^3.0.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "heic2any": "^0.0.4"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.1",
    "@types/react": "^18.3.28",
    "typescript": "^5.9.3"
  }
}
