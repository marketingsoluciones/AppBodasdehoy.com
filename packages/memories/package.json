{
  "name": "@bodasdehoy/memories",
  "version": "1.0.0",
  "private": true,
  "description": "Memories - Álbumes y fotos por evento. Paquete compartido para Copilot, App Bodas, CRM, ERP.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "echo \"no lint configured\" && exit 0"
  },
  "dependencies": {
    "@bodasdehoy/shared": "workspace:*",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "memories",
    "albums",
    "bodasdehoy",
    "monorepo"
  ],
  "author": "BodasdeHoy",
  "license": "MIT"
}
