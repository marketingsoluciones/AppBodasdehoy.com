# ========================================
# ENDPOINTS — REQUIRED para que la app arranque
# ========================================
# ⚠️ NEXT_PUBLIC_API_MCP_GRAPHQL_URL es OBLIGATORIO. Sin él la app
# devuelve HTTP 500 en cualquier ruta (utils/endpoints.ts lo valida
# en runtime). Si tu .env.local fue generado por Vercel CLI y no lo
# incluye, AÑADIRLO MANUALMENTE.
NEXT_PUBLIC_API_MCP_GRAPHQL_URL=https://api-mcp.eventosorganizador.com/graphql

# API IA (memories) — usado para integraciones IA opcionales
NEXT_PUBLIC_API_IA_URL=https://api-ia.bodasdehoy.com

# ========================================
# OBSERVABILIDAD (opcional — Sentry)
# ========================================
# Si no se define, Sentry queda completamente inactivo (cero overhead).
# Crear el proyecto en https://sentry.io (org: itel-0n, project: memories-web)
# y pegar el DSN aquí.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

