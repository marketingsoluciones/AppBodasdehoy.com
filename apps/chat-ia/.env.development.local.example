# Solo para DESARROLLO LOCAL. En producción chat-test no lleva puerto.
# Copia a .env.development.local para usar en local con dominios y puertos.
# Así OAuth y redirects usan la URL correcta del copilot.
#
# Requiere /etc/hosts:
#   127.0.0.1   app-test.bodasdehoy.com
#   127.0.0.1   chat-test.bodasdehoy.com
#
# Levantar con: pnpm dev:local (desde la raíz) o pnpm run dev:local (desde apps/copilot)

APP_URL=http://chat-test.bodasdehoy.com:3210
NEXT_PUBLIC_API_MCP_GRAPHQL_URL=https://api-mcp.eventosorganizador.com/graphql
API_MCP_GRAPHQL_URL=https://api-mcp.eventosorganizador.com/graphql
NEXT_PUBLIC_API_IA_URL=https://api3-ia.eventosorganizador.com
API_IA_URL=https://api3-ia.eventosorganizador.com

# ========================================
# OBSERVABILIDAD (opcional — Sentry)
# ========================================
# Si no se define, Sentry queda completamente inactivo (cero overhead).
# Crear el proyecto en https://sentry.io (org: itel-0n, project: chat-ia)
# y pegar el DSN aquí.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
