# ========================================
# ENDPOINTS — solo 2 APIs, 4 nombres válidos.
# Fuente única de verdad: docs/ENV-ENDPOINTS-STANDARD.md
# Cualquier otro alias (API_BODAS_URL, API3_*, PYTHON_BACKEND_URL, etc.) está
# RETIRADO y dispara error en runtime.
# ========================================

# API IA (chat IA, memories, leads sub-router, tools)
API_IA_URL=https://api-ia.bodasdehoy.com
NEXT_PUBLIC_API_IA_URL=https://api-ia.bodasdehoy.com

# API MCP GraphQL (datos: eventos, invitados, mesas, presupuesto, notificaciones)
API_MCP_GRAPHQL_URL=https://api-mcp.eventosorganizador.com/graphql
NEXT_PUBLIC_API_MCP_GRAPHQL_URL=https://api-mcp.eventosorganizador.com/graphql

# Imágenes/assets (temporalmente apiapp; en el futuro irá a un dominio dedicado)
NEXT_PUBLIC_IMAGES_BASE_URL=https://apiapp.bodasdehoy.com

# ========================================
# PDF (api-convert) — solo servidor, nunca NEXT_PUBLIC_*
# ========================================
# Misma CONVERT_TOKEN que api-convert (.env). Mín. 32 chars.
CONVERT_API_URL=https://api-convert.bodasdehoy.com
CONVERT_TOKEN=change-me-to-a-long-random-secret-at-least-32-chars
# Dev en el mismo host (opcional): CONVERT_API_URL=http://127.0.0.1:4004

# ========================================
# OBSERVABILIDAD (opcional — Sentry)
# ========================================
# Si no se define, Sentry queda completamente inactivo (cero overhead).
# Crear el proyecto en https://sentry.io (org: itel-0n, project: app-eventos)
# y pegar el DSN aquí.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
