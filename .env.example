# Copia este archivo a .env y rellena solo en tu máquina.
# Nunca subas .env a git (está en .gitignore).
#
# REGLA: solo existen 2 APIs en este proyecto. Cualquier otro alias está RETIRADO.
# Ver docs/ENV-ENDPOINTS-STANDARD.md

# ── APIs canónicas (únicas válidas) ─────────────────────────────────────────────

# API MCP GraphQL (datos: eventos, invitados, mesas, presupuesto, notificaciones)
API_MCP_GRAPHQL_URL=https://api-mcp.eventosorganizador.com/graphql
NEXT_PUBLIC_API_MCP_GRAPHQL_URL=https://api-mcp.eventosorganizador.com/graphql

# API IA (chat IA, memories, leads sub-router, tools)
#
# Comprobado 15-09: `api3-ia.eventosorganizador.com` —el valor que estaba aquí—
# NO resuelve por DNS. Los hosts vivos son estos dos, ambos responden 200:
#   https://api-ia.bodasdehoy.com          (el default del código)
#   https://api-ia.eventosorganizador.com
API_IA_URL=https://api-ia.bodasdehoy.com
NEXT_PUBLIC_API_IA_URL=https://api-ia.bodasdehoy.com

# ── Slack — canal #copilot-api-ia ───────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_FRONTEND=
SLACK_CHANNEL_FRONTEND=C0AEV0GCLM7

# ── Imágenes/assets (temporal, va a desaparecer) ────────────────────────────────
# NEXT_PUBLIC_IMAGES_BASE_URL=https://apiapp.bodasdehoy.com

# ── Credenciales de prueba (opcional, ver memory/feedback_test_credentials.md) ──
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
